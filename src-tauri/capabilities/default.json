{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Explicit viewer and fixed signed-update commands. Source changes and update installation require native consent. No generic shell, filesystem, network or remote-origin permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-read-world-snapshot", "allow-detect-hermes", "allow-configure-hermes",
    "allow-detect-remote-hermes", "allow-configure-remote-hermes", "allow-configured-remote",
    "allow-recover-configuration", "allow-open-company-site",
    "allow-app-update-status", "allow-check-app-update", "allow-install-app-update"
  ]
}
