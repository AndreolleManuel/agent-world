{
  "name": "pixel-ops",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:release": "node --test scripts/*.test.mjs",
    "check:signing": "node scripts/check-signing.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "audit:assets": "node scripts/inventory-assets.mjs",
    "audit:dependencies": "node scripts/inventory-dependencies.mjs",
    "build:notices": "node scripts/build-notices.mjs",
    "prepare:public": "node scripts/prepare-public-source.mjs",
    "build:mac": "node scripts/build-mac.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build:beta": "node scripts/build-mac.mjs",
    "package:beta": "node scripts/package-beta.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "pixi.js": "8.20.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "4.1.11"
  }
}
